        "CONFIG_ESPTOOLPY_FLASHMODE_QIO=n",
        "CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y",
        "CONFIG_SPIRAM_SPEED_200M=n",
        "CONFIG_SPIRAM_SPEED_80M=y",
        "CONFIG_SPIRAM_XIP_FROM_PSRAM=n",
        "CONFIG_USE_WECHAT_MESSAGE_STYLE=y",
        "CONFIG_USE_DEFAULT_MESSAGE_STYLE=n",
        "CONFIG_WAKE_WORD_DISABLED=y",
        "CONFIG_USE_AFE_WAKE_WORD=n",
        "CONFIG_USE_DEVICE_AEC=n",
        "CONFIG_USE_SERVER_AEC=n",
        "CONFIG_LANGUAGE_PL_PL=y",
        "CONFIG_USE_HOTSPOT_WIFI_PROVISIONING=y",
        "CONFIG_USE_ESP_BLUFI_WIFI_PROVISIONING=n",
        "CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y"
      ]
    }
  ]
